{
  "name": "darkterminal/escpos-printer-server",
  "description": "The fck'in simple escpos printer server",
  "type": "library",
  "version": "2.0.10",
  "require": {
    "php": "^8.3",
    "workerman/workerman": "^5.1"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Darkterminal\\EscposPrinterServer\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "create:phar": "sh ./build-phar.sh",
    "create:bundle": "sh ./make-bundle.sh",
    "release:patch": "sh ./release.sh patch",
    "release:minor": "sh ./release.sh minor",
    "release:major": "sh ./release.sh major",
    "test": "php -d zend.assertions=1 vendor/bin/pest --colors=always",
    "lint": "pint --test tests",
    "lint:fix": "pint tests"
  },
  "bin": "./eps",
  "authors": [
    {
      "name": "Imam Ali Mustofa",
      "email": "darkterminal@duck.com"
    }
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/darkterminal"
    },
    {
      "type": "saweria",
      "url": "https://saweria.co/darkterminal"
    }
  ],
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.9.1",
    "pestphp/pest": "^4.0",
    "laravel/pint": "^1.0",
    "mike42/escpos-php": "^5.0"
  },
  "extra": {
    "bamarni-bin": {
      "bin-links": false,
      "forward-command": true
    }
  },
  "config": {
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true,
      "pestphp/pest-plugin": true
    },
    "platform": {
      "php": "8.3.0"
    }
  }
}
